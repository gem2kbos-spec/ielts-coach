# 当前版本不需要任何 API Key：
# - AI 评分/考官追问 复用本机已登录的 Claude Code CLI（子进程调用 claude -p）
# - 语音转录 用本地编译的 whisper.cpp
# - 语音合成 用 macOS 自带的 say 命令
#
# 以下变量为可选项，留作未来切换到云端方案时使用，默认不需要配置。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 想试试用 DeepSeek 代替 Claude 做评分（更便宜，但中文教学场景的细致程度未必如 Claude）：
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

PORT=3000
