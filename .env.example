# 默认版本不强制需要任何 API Key：
# - AI 评分/考官追问 复用本机已登录的 Claude Code CLI（子进程调用 claude -p）
# - 语音转录 用本地编译的 whisper.cpp
# - 听力音频默认用免费的 Microsoft Edge Neural TTS；Edge 不可用时退回 macOS say 占位音
#
# 如需强制使用 OpenAI TTS，可配置 OPENAI_API_KEY 并设置 LISTENING_TTS_PROVIDER=openai。
# LISTENING_TTS_PROVIDER=edge
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_FORMAT=mp3
# ANTHROPIC_API_KEY=

# 想试试用 DeepSeek 代替 Claude 做评分（更便宜，但中文教学场景的细致程度未必如 Claude）：
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

PORT=3000
# DEBUG_REQUESTS=1
